{
  "name": "task-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Task management desktop app",
  "author": "Bhavik",
  "main": "electron/main.js",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.13.2",
    "concurrently": "^9.2.1",
    "date-fns": "^4.1.0",
    "react": "^19.2.1",
    "react-datepicker": "^8.10.0",
    "react-dom": "^19.2.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.10.1",
    "react-scripts": "^5.0.1",
    "react-select": "^5.10.2",
    "wait-port": "^1.1.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "react-start": "PORT=5173 react-scripts start",
    "build": "react-scripts build",
    "electron-start": "electron .",
    "start": "concurrently --kill-others --success=exit-first \"npm run react-start\" \"npm run electron-start\"",
    "dist": "npm run build && electron-builder"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "build": {
    "appId": "com.taskapp.electron",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetaData": {
      "main": "electron/main.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18"
  }
}
